# Production only. No trailing slash. Put this HTTPS origin behind a reverse proxy.
PUBLIC_ORIGIN=https://ironlog.example.com
# For npm start: Node reads this file only when invoked with --env-file=.env.
# Development works without any environment file.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/ironlog.sqlite

# Automatic consistent SQLite snapshots, stored in data/backups on the persistent volume.
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=28

# Optional: use compose.public.yaml for Caddy + automatic HTTPS.
IRONLOG_DOMAIN=ironlog.example.com
